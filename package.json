{
  "name": "openwarp",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "account": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/account.mjs",
    "verify:e2e": "sh scripts/verify-e2e.sh"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "better-auth": "1.7.28",
    "clsx": "2.1.1",
    "jose": "6.2.18",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
