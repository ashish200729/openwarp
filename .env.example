# Generate each required secret independently with openssl rand -hex 32.
POSTGRES_PASSWORD=
OPENWARP_DB_PASSWORD=
BETTER_AUTH_SECRET=

OPENWARP_PORT=3080
BETTER_AUTH_URL=http://127.0.0.1:3080
OPENWARP_WORKSPACE_NAME=People workspace

# Seals bank details, identity data and two-factor secrets. Set it before entering any of them and never change it.
OPENWARP_DATA_KEY=

# Optional email. Password reset by email appears when both are set.
# OPENWARP_SMTP_URL=smtp://user:password@mail.example.com:587
# OPENWARP_EMAIL_FROM=OpenWarp <people@example.com>

# Optional single sign-on. Register <origin>/api/sso/callback as the redirect URI.
# OPENWARP_OIDC_ISSUER=https://id.example.com
# OPENWARP_OIDC_CLIENT_ID=
# OPENWARP_OIDC_CLIENT_SECRET=
# OPENWARP_OIDC_LABEL=Example ID

# Set these only when running Node on the host with an external PostgreSQL database.
# DATABASE_URL=postgresql://openwarp_app:PASSWORD@127.0.0.1:5432/openwarp
# MIGRATION_DATABASE_URL=postgresql://openwarp_owner:PASSWORD@127.0.0.1:5432/openwarp
